# chatNut Environment Configuration

# Server Port (Render sets this automatically)
PORT=8000

# MongoDB Database URI (Optional: If omitted, chatNut uses built-in in-memory storage)
# Example MongoDB Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/chatNut?retryWrites=true&w=majority
MONGO_URI=

# Real-Time Email OTP Verification (Optional)
# If using Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_PASS=

# Custom SMTP (Optional, only needed if not using Gmail)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_api_key
